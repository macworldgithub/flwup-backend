{
  "name": "boran-motors-crm-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Boran Motors CRM — Backend data fetcher and compiler. Pulls live data from FLWUP API and compiles it for the frontend CRM.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "server": "node src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "db:status": "node src/scripts/view-db.js",
    "fetch": "node index.js",
    "fetch:leads": "node index.js --only leads",
    "fetch:dashboard": "node index.js --only dashboard",
    "fetch:reports": "node index.js --only reports",
    "fetch:combined": "node index.js --combined",
    "build-data": "node scripts/build-data.js",
    "fetch-and-build": "node index.js --only leads,dashboard,reports && node scripts/build-data.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "crm",
    "boran-motors",
    "flwup",
    "automotive"
  ],
  "author": "Boran Motors Group",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
