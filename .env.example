# Database & Server Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# Flwup auth token
# DevTools -> Network -> any request -> Request Headers -> authorization
FLWUP_TOKEN=your_flwup_token_here

# Optional: fallback list of dealership IDs if rooftops list cannot be read
DEALERSHIP_IDS=

# Optional reports configuration
REPORTS_ENDPOINT=POST /api/manager/reports/run
REPORTS_ROOFTOP_ID=
