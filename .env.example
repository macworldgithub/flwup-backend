# Database & Server Configuration
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# ==============================================================================
# FLWUP Authentication & Automated Token Renewal
# ==============================================================================
# Option 1 (Recommended — 100% automated, never expires):
# Provide your FLWUP account credentials. The system automatically signs in
# via Supabase Auth and rotates tokens so they NEVER expire.
FLWUP_EMAIL=megant@booranmotors.com.au
FLWUP_PASSWORD=your_flwup_password_here

# Option 2 (Browser Refresh Token — auto-rotates and keeps renewing):
# Open Chrome DevTools -> Application -> Local Storage -> https://flwup.com.au
# Copy the "refresh_token" property from the "sb-nzpuhnqobsffhcqejmgv-auth-token" object.
FLWUP_REFRESH_TOKEN=

# Access Token (auto-updated by the system on every renewal)
FLWUP_TOKEN=your_flwup_token_here

# Optional: fallback list of dealership IDs if rooftops list cannot be read
DEALERSHIP_IDS=

# Optional reports configuration
REPORTS_ENDPOINT=POST /api/manager/reports/run
REPORTS_ROOFTOP_ID=
