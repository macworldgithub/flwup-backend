# --- reports (flwup_reports.js) ---
# The "run a report" URL wasn't in the info I had, so the script guesses. If it can't find it,
# copy the request from the Network tab and set it here as "METHOD /path", e.g.:
# REPORTS_ENDPOINT=POST /api/manager/reports/run
# REPORTS_ENDPOINT=GET /api/manager/reports/{preset}
# Optional x-rooftop-id header for the reports calls:
# REPORTS_ROOFTOP_ID=